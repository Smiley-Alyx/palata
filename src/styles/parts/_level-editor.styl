// Console-only level editor overlay.

.level-editor
  position absolute
  inset 0
  z-index 40
  display grid
  grid-template-rows auto minmax(0, 1fr)
  background #080909
  color $text
  font-family $mono

.level-editor__header
  display grid
  grid-template-columns minmax(0, 1fr) auto
  gap 12px
  align-items center
  padding 10px 12px
  border-bottom 2px solid rgba(243, 210, 122, 0.35)
  background #14100d

.level-editor__title
  min-width 0
  overflow hidden
  color $accent
  font-size 14px
  font-weight 700
  line-height 1.2
  text-overflow ellipsis
  white-space nowrap

.level-editor__actions
  display flex
  align-items center
  gap 8px

.level-editor__status
  min-width 108px
  color rgba(216, 216, 216, 0.72)
  font-size 12px
  text-align right

.level-editor__button,
.level-editor__tool
  border 2px solid $wood
  background #23170f
  color $text
  font inherit
  font-size 12px
  line-height 1
  padding 8px 10px
  cursor pointer

.level-editor__button:hover,
.level-editor__tool:hover,
.level-editor__tool.is-selected
  border-color $accent
  color $accent
  background #2a2117

.level-editor__layout
  min-height 0
  display grid
  grid-template-columns 190px minmax(0, 1fr)

.level-editor__sidebar
  min-height 0
  overflow auto
  padding 12px
  border-right 2px solid rgba(107, 74, 43, 0.7)
  background #111

.level-editor__section-title
  margin-bottom 8px
  color $accent
  font-size 12px
  letter-spacing 1px
  text-transform uppercase

.level-editor__tools
  display grid
  gap 7px

.level-editor__tool
  width 100%
  text-align left

.level-editor__info
  display grid
  grid-template-columns auto minmax(0, 1fr)
  gap 6px 10px
  margin 16px 0 0
  font-size 12px

.level-editor__info dt
  color rgba(216, 216, 216, 0.56)

.level-editor__info dd
  margin 0
  min-width 0
  overflow hidden
  color rgba(216, 216, 216, 0.86)
  text-overflow ellipsis
  white-space nowrap

.level-editor__hint
  margin 16px 0 0
  color rgba(216, 216, 216, 0.58)
  font-size 11px
  line-height 1.45

.level-editor__stage
  min-width 0
  min-height 0
  overflow auto
  padding 18px
  background #050505

.level-editor__grid
  --level-editor-cell 16px
  display grid
  grid-template-columns repeat(var(--level-editor-cols), var(--level-editor-cell))
  width max-content
  border 1px solid rgba(243, 210, 122, 0.28)
  background rgba(243, 210, 122, 0.12)

.level-editor__cell
  position relative
  width var(--level-editor-cell)
  height var(--level-editor-cell)
  border 0
  border-right 1px solid rgba(255, 255, 255, 0.05)
  border-bottom 1px solid rgba(255, 255, 255, 0.05)
  background #161616
  padding 0
  cursor crosshair

.level-editor__cell:hover
  outline 2px solid $accent
  outline-offset -2px

.level-editor__cell[data-value='0']
  background #151515

.level-editor__cell[data-value='1']
  background #6a6c70

.level-editor__cell[data-value='3']
  background #2c8aa0

.level-editor__cell[data-value='6']
  background #9b6a22

.level-editor__cell[data-value='7']
  background #2e8c45

.level-editor__cell.has-spawn::after
  content 'S'
  position absolute
  inset 2px
  display flex
  align-items center
  justify-content center
  background #b51f5b
  color #fff
  font-size 10px
  font-weight 700
  line-height 1
  text-shadow 1px 1px 0 #000

@media (max-width: 760px)
  .level-editor__header
    grid-template-columns 1fr

  .level-editor__actions
    flex-wrap wrap

  .level-editor__layout
    grid-template-columns 1fr
    grid-template-rows auto minmax(0, 1fr)

  .level-editor__sidebar
    border-right 0
    border-bottom 2px solid rgba(107, 74, 43, 0.7)

  .level-editor__tools
    grid-template-columns repeat(3, minmax(0, 1fr))
