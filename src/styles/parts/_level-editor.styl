// Console-only level editor overlay.

.level-editor
  position absolute
  inset 0
  z-index 40
  display grid
  grid-template-rows auto minmax(0, 1fr)
  background #080909
  color $text
  font-family $mono

.level-editor__header
  display grid
  grid-template-columns minmax(0, 1fr) auto
  gap 12px
  align-items center
  padding 10px 12px
  border-bottom 2px solid rgba(243, 210, 122, 0.35)
  background #14100d

.level-editor__title
  min-width 0
  overflow hidden
  color $accent
  font-size 14px
  font-weight 700
  line-height 1.2
  text-overflow ellipsis
  white-space nowrap

.level-editor__actions
  display flex
  align-items center
  gap 8px

.level-editor__status
  min-width 108px
  color rgba(216, 216, 216, 0.72)
  font-size 12px
  text-align right

.level-editor__button,
.level-editor__tool
  border 2px solid $wood
  background #23170f
  color $text
  font inherit
  font-size 12px
  line-height 1
  padding 8px 10px
  cursor pointer

.level-editor__button:hover,
.level-editor__tool:hover,
.level-editor__tool.is-selected
  border-color $accent
  color $accent
  background #2a2117

.level-editor__tool.is-selected
  box-shadow inset 4px 0 0 $accent

.level-editor__button:disabled
  opacity 0.35
  cursor default

.level-editor__layout
  min-height 0
  display grid
  grid-template-columns 190px minmax(0, 1fr) 280px

.level-editor__sidebar,
.level-editor__inspector
  min-height 0
  overflow auto
  padding 12px
  background #111

.level-editor__sidebar
  border-right 2px solid rgba(107, 74, 43, 0.7)

.level-editor__inspector
  border-left 2px solid rgba(107, 74, 43, 0.7)

.level-editor__section-title
  margin-bottom 8px
  color $accent
  font-size 12px
  letter-spacing 1px
  text-transform uppercase

.level-editor__section-title--spaced
  margin-top 18px

.level-editor__section-title[title],
.level-editor__palette-group[title]
  cursor help

.level-editor__current-tool
  display grid
  gap 4px
  margin-bottom 12px
  padding 9px
  border 2px solid rgba(243, 210, 122, 0.65)
  background #1a1511

.level-editor__current-tool-label
  color rgba(216, 216, 216, 0.52)
  font-size 9px
  letter-spacing 1px
  text-transform uppercase

.level-editor__current-tool-mode
  color $accent
  font-size 12px
  line-height 1.25

.level-editor__current-tool-brush
  color #fff
  font-size 11px
  line-height 1.3
  word-break break-word

.level-editor__current-tool-action
  color rgba(216, 216, 216, 0.62)
  font-size 10px
  line-height 1.4

.level-editor__zoom
  display grid
  grid-template-columns 34px minmax(46px, 1fr) 34px
  gap 6px
  align-items center

.level-editor__zoom-button
  height 30px
  border 2px solid $wood
  background #23170f
  color $text
  font inherit
  font-size 16px
  line-height 1
  cursor pointer

.level-editor__zoom-button:hover
  border-color $accent
  color $accent
  background #2a2117

.level-editor__zoom-value
  color rgba(216, 216, 216, 0.82)
  font-size 12px
  text-align center

.level-editor__zoom input
  grid-column 1 / -1
  width 100%
  accent-color $accent

.level-editor__resize
  display grid
  grid-template-columns minmax(0, 1fr) minmax(0, 1fr)
  gap 6px

.level-editor__resize input
  min-width 0
  border 1px solid rgba(107, 74, 43, 0.9)
  background #090909
  color $text
  font inherit
  font-size 11px
  padding 5px 6px

.level-editor__resize .level-editor__button
  grid-column 1 / -1

.level-editor__tools
  display grid
  gap 7px

.level-editor__tool
  width 100%
  text-align left

.level-editor__info
  display grid
  grid-template-columns auto minmax(0, 1fr)
  gap 6px 10px
  margin 16px 0 0
  font-size 12px

.level-editor__info dt
  color rgba(216, 216, 216, 0.56)

.level-editor__info dd
  margin 0
  min-width 0
  overflow hidden
  color rgba(216, 216, 216, 0.86)
  text-overflow ellipsis
  white-space nowrap

.level-editor__hint
  margin 16px 0 0
  color rgba(216, 216, 216, 0.58)
  font-size 11px
  line-height 1.45

.level-editor__palette
  display grid
  gap 7px

.level-editor__palette-group
  margin 6px 0 0
  color rgba(216, 216, 216, 0.55)
  font-size 11px
  letter-spacing 1px
  text-transform uppercase

.level-editor__palette-button
  --preview-image none
  min-height 34px
  border 2px solid rgba(107, 74, 43, 0.9)
  background #1a1511
  color $text
  font inherit
  font-size 11px
  line-height 1.15
  padding 7px 8px 7px 38px
  position relative
  text-align left
  cursor pointer

.level-editor__palette-button::before
  content ''
  position absolute
  left 7px
  top 50%
  width 22px
  height 22px
  transform translateY(-50%)
  border 1px solid rgba(243, 210, 122, 0.24)
  background-color #090909
  background-image var(--preview-image)
  background-position center
  background-repeat no-repeat
  background-size cover

.level-editor__palette-button:hover,
.level-editor__palette-button.is-selected
  border-color $accent
  color $accent
  background #241d15

.level-editor__palette-button.is-selected
  box-shadow inset 4px 0 0 $accent

.level-editor__form
  display grid
  gap 8px

.level-editor__selection
  display grid
  gap 8px
  color rgba(216, 216, 216, 0.64)
  font-size 11px
  line-height 1.35

.level-editor__selection-item
  border 1px solid rgba(107, 74, 43, 0.9)
  background #0b0b0b

.level-editor__selection-subtitle
  color $accent
  font-size 11px
  font-weight 700

.level-editor__selection-form
  margin-bottom 4px
  padding 8px
  border 1px solid rgba(243, 210, 122, 0.42)
  background #15120f

.level-editor__selection-title
  padding 6px 7px
  border-bottom 1px solid rgba(107, 74, 43, 0.55)
  color $accent
  font-size 11px
  font-weight 700

.level-editor__selection-value
  max-height 160px
  margin 0
  overflow auto
  padding 7px
  color rgba(216, 216, 216, 0.86)
  font inherit
  font-size 10px
  line-height 1.35
  white-space pre-wrap
  word-break break-word

.level-editor__field
  display grid
  grid-template-columns 72px minmax(0, 1fr)
  gap 8px
  align-items center
  color rgba(216, 216, 216, 0.72)
  font-size 11px

.level-editor__field input,
.level-editor__field select
  min-width 0
  border 1px solid rgba(107, 74, 43, 0.9)
  background #090909
  color $text
  font inherit
  font-size 11px
  padding 5px 6px

.level-editor__field input[type='color']
  min-height 28px
  padding 2px

.level-editor__field--checkbox
  grid-template-columns 72px auto
  justify-content start

.level-editor__stage
  min-width 0
  min-height 0
  overflow auto
  padding 18px
  background #050505

.level-editor__grid
  --level-editor-cell 16px
  display grid
  grid-template-columns repeat(var(--level-editor-cols), var(--level-editor-cell))
  width max-content
  border 1px solid rgba(243, 210, 122, 0.28)
  background rgba(243, 210, 122, 0.12)

.level-editor__cell
  position relative
  width var(--level-editor-cell)
  height var(--level-editor-cell)
  border 0
  border-right 1px solid rgba(255, 255, 255, 0.05)
  border-bottom 1px solid rgba(255, 255, 255, 0.05)
  background #161616
  padding 0
  cursor crosshair
  overflow hidden

.level-editor__cell:hover
  outline 2px solid $accent
  outline-offset -2px

.level-editor__cell.is-selected
  outline 2px solid #fff
  outline-offset -2px

.level-editor__cell[data-value='0']
  background #151515

.level-editor__cell[data-value='1']
  background #6a6c70

.level-editor__cell[data-value='3']
  background #2c8aa0

.level-editor__cell[data-value='6']
  background #9b6a22

.level-editor__cell[data-value='7']
  background #2e8c45

.level-editor__cell[data-value='8']
  background #57602a

.level-editor__cell[data-value='9']
  background #74505b

.level-editor__cell[data-material='1']
  box-shadow inset 0 0 0 2px rgba(243, 210, 122, 0.42)

.level-editor__marker
  position absolute
  display flex
  align-items center
  justify-content center
  width 8px
  height 8px
  border-radius 1px
  color #fff
  font-size 7px
  font-weight 700
  line-height 1
  pointer-events none

.level-editor__marker--material
  left 1px
  top 1px
  background #b88f2d

.level-editor__marker--entity
  right 1px
  top 1px
  background #b51f5b

.level-editor__marker--light
  left 1px
  bottom 1px
  background #f0c64a
  color #111

.level-editor__marker--trigger
  right 1px
  bottom 1px
  background #3f84d8

.level-editor__cell.has-spawn::after
  content 'S'
  position absolute
  inset 2px
  display flex
  align-items center
  justify-content center
  background #b51f5b
  color #fff
  font-size 10px
  font-weight 700
  line-height 1
  text-shadow 1px 1px 0 #000

.level-editor__asset-viewer
  position absolute
  inset 0
  z-index 60
  display grid
  grid-template-rows auto minmax(0, 1fr) auto auto
  gap 16px
  padding 16px
  background rgba(0, 0, 0, 0.94)

.level-editor__asset-viewer[hidden]
  display none

.level-editor__asset-viewer-header
  display flex
  gap 12px
  align-items center
  justify-content space-between

.level-editor__asset-viewer-title
  color $accent
  font-size 15px
  line-height 1.3

.level-editor__asset-viewer-media
  min-width 0
  min-height 0
  display grid
  place-items center

.level-editor__asset-viewer-image
  display block
  max-width calc(100vw - 32px)
  max-height calc(100vh - 180px)
  border 2px solid rgba(243, 210, 122, 0.55)
  background-color #222
  background-image linear-gradient(45deg, #333 25%, transparent 25%),
    linear-gradient(-45deg, #333 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #333 75%),
    linear-gradient(-45deg, transparent 75%, #333 75%)
  background-position 0 0, 0 8px, 8px -8px, -8px 0
  background-size 16px 16px
  image-rendering pixelated
  object-fit contain

.level-editor__asset-viewer-image[hidden]
  display none

.level-editor__asset-viewer-controls
  display grid
  grid-template-columns auto minmax(120px, 220px) auto
  gap 8px
  justify-content center

.level-editor__asset-viewer-controls[hidden]
  display none

.level-editor__asset-viewer-select
  min-width 0
  border 2px solid $wood
  background #090909
  color $text
  font-family $mono
  font-size 11px
  padding 5px 6px

.level-editor__asset-viewer-path
  overflow hidden
  color rgba(216, 216, 216, 0.68)
  font-size 11px
  line-height 1.4
  text-align center
  text-overflow ellipsis
  white-space nowrap

.level-editor-playtest-return
  position absolute
  z-index 35
  right 14px
  top 14px
  border 2px solid $accent
  background #23170f
  color $accent
  font-family $mono
  font-size 12px
  padding 9px 12px
  cursor pointer

.level-editor-playtest-return:hover
  background #2a2117
  color #fff

@media (max-width: 760px)
  .level-editor__header
    grid-template-columns 1fr

  .level-editor__actions
    flex-wrap wrap

  .level-editor__layout
    grid-template-columns 1fr
    grid-template-rows auto minmax(0, 1fr) auto

  .level-editor__sidebar
    border-right 0
    border-bottom 2px solid rgba(107, 74, 43, 0.7)

  .level-editor__inspector
    border-left 0
    border-top 2px solid rgba(107, 74, 43, 0.7)

  .level-editor__tools
    grid-template-columns repeat(3, minmax(0, 1fr))
